# --- Database ------------------------------------------------------------
# Postgres. Saved mindmaps and their history live here; without it the app
# still runs, it just forgets everything. Neon's pooled connection string is
# what this was built against — take the one ending in "-pooler", and append
# "&uselibpqcompat=true": without it node-postgres treats sslmode=require as
# "encrypt but do not check who you are talking to".
DATABASE_URL=

# --- Auth (Supabase) ------------------------------------------------------
# Optional. Without it, history still works: every browser owns its own maps
# through a cookie. Signing in is what makes that history follow someone to
# another machine, and the maps they made while signed out are claimed by the
# account on the next request.
#
# Both values are public by design — they ship in the browser bundle. The
# service-role key is NOT used and must never be added here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required — writes the lesson (what gets drawn and what gets said).
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna. Must support structured outputs.
OPENAI_MODEL=gpt-5.6-luna

# --- Voice ---------------------------------------------------------------
# "fish", "elevenlabs" or "openai". This choice decides how well the drawing
# stays with the voice, because it decides what timing data comes back:
#
#   elevenlabs  per character, exact. A shape lands on its own word.
#   fish        word timestamps are returned alongside the audio, so a shape
#               can appear as the teacher says the relevant word.
#   openai      none at all. Shapes are spread evenly across the clip.
#
# Without a usable key for the chosen provider, lessons play silently with
# captions rather than failing.
TTS_PROVIDER=fish

# Fish Audio — fish.audio/go/api-keys
FISH_API_KEY=
# Falls back to the voice picked in the player, then to Eve. The picker's three
# voices map onto Fish where a counterpart exists.
FISH_VOICE_ID=
# s2-pro (default, recommended) or s1. Sent as a header, not a body field.
FISH_MODEL=s2-pro
# Fish's timestamped stream is used for word-level sync. Set to "off" only to
# skip those timings and fall back to scene-level playback timing.
FISH_LANGUAGE=en
FISH_ALIGNMENT=

ELEVENLABS_API_KEY=
# EVE. Alternatives: Hope uYXf8XasLslADfZ2MB4u, Ivy MClEFoImJXBTgLwdLI5n
ELEVENLABS_VOICE_ID=BZgkqPqms7Kj9ulSkVzn
# eleven_v3 performs the inline [delivery tags] the narration is written with.
# eleven_multilingual_v2 is steadier but ignores them; turbo/flash are faster
# and noticeably flatter.
ELEVENLABS_MODEL_ID=eleven_v3

# Used when TTS_PROVIDER=openai.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_TTS_VOICE=sage

# --- Images --------------------------------------------------------------
# Images work with none of these set: the search falls back to Openverse and
# Wikimedia Commons, which need no key, no Cloud project and no card. A key
# below buys better everyday-object photographs, nothing more, and the chain
# falls through to the keyless pair the moment one runs out of quota.
#
# If pictures stop appearing: /api/image/test?q=apple&html=1 says why.
#
# Unsplash — tried first, and the best fit for a board: large, deliberate
# photographs of real objects. Register an app at unsplash.com/developers and
# copy the Access Key. Free, no card, no project. A demo app gets 50 requests
# an hour; "apply for production" lifts it to 5000.
UNSPLASH_ACCESS_KEY=

# Google Programmable Search — 100 free queries a day. Needs two things:
#   1. Enable "Custom Search API" for your project:
#      console.cloud.google.com/apis/library/customsearch.googleapis.com
#   2. Create a search engine at programmablesearchengine.google.com with
#      "Search the entire web" and "Image search" on, and copy its engine ID.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# SerpApi's Google Images endpoint. Used only when Google isn't configured; its
# free tier is a few hundred searches total and one lesson spends a dozen.
# https://serpapi.com/google-images-api
SERPAPI_KEY=

# Optional. "google" or "serpapi" — pins the provider instead of preferring
# whichever is configured. Handy for testing one side.
IMAGE_PROVIDER=
# Optional. Signs the image proxy URLs; falls back to whichever search key is
# set. Only needs to be stable and non-public.
IMAGE_PROXY_SECRET=

# The Noun Project — line-art symbols, for the "symbol" shape. A drawn glyph of
# a router or a firewall, where a photograph would only be a black box with
# lights on it. Sign up at thenounproject.com/developers; the API is OAuth 1.0a,
# so it needs both halves of the key pair.
#
# Icons are Creative Commons Attribution unless marked public domain, and the
# search prefers public-domain results where they exist. If you publish a
# lesson, credit the creators — /api/icon returns the attribution string.
NOUN_PROJECT_KEY=
NOUN_PROJECT_SECRET=

# --- Manim engine ---------------------------------------------------------
# Required by the manim engine, which renders every scene to video on the
# server. Without it that engine has no picture — the narration still plays,
# and every other engine is unaffected. Check at /api/render.
#
#   sudo apt install -y python3-dev python3-venv ffmpeg libcairo2-dev \
#                       libpango1.0-dev pkg-config build-essential
#
#   python3 -m venv ~/.venvs/manim && ~/.venvs/manim/bin/pip install manim
#
# python3-dev is not optional: pycairo and manimpango are C extensions, and
# without the headers meson fails with "Python dependency not found" even
# though cairo itself was found.
#
# Then point this at it (a bare "manim" works if it's on PATH):
MANIM_BIN=
# l (480p15, default), m (720p30), h (1080p60). Render time scales steeply.
MANIM_QUALITY=l
# Milliseconds before a scene render is abandoned. Default 240000.
MANIM_TIMEOUT=

# Optional — only needed to deploy over HTTPS on a real domain.
# tldraw runs unlicensed on localhost. See https://tldraw.dev/legal/tldraw-license
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
