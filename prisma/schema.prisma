// The store behind /mindmap.
//
// Postgres, over the pooled Neon connection in DATABASE_URL. The tree is a
// String of JSON rather than a Json column on purpose: a map is read whole,
// drawn whole and written whole, nothing ever queries inside it, and a String
// keeps the schema portable to any provider.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One saved map, tree and all.
///
/// The whole tree lives in a single row rather than a table of nodes with
/// parent pointers. A map is loaded whole, drawn whole and saved whole; nothing
/// ever queries for "the children of node X" across maps, and a node table
/// would buy joins for a read pattern that has none.
model Mindmap {
  id String @id @default(cuid())

  /// Who it belongs to.
  ///
  /// `ownerKey` is an anonymous browser identity — a cookie — so history works
  /// before anyone has signed in. `userId` is filled in once accounts exist,
  /// and the two coexist on purpose: at sign-up, the maps made while signed
  /// out are claimed by stamping the user onto every row with that ownerKey,
  /// rather than being lost.
  ownerKey String
  userId   String?

  /// What was asked for, and what came back.
  title  String
  topic  String @default("")
  /// "model" when the branches were written for you, "outline" when they were
  /// typed by hand — the two are different products and worth telling apart.
  source String @default("model")

  /// The MindNode tree as JSON, exactly as lib/mindmap.ts hands it over.
  tree String

  /// Denormalised for the history list, which would otherwise parse every
  /// tree it lists just to say how big each one is.
  nodeCount Int @default(1)
  depth     Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey, updatedAt])
  @@index([userId, updatedAt])
}

/// One lesson, kept so it can be watched again.
///
/// Stored as the finished lesson document — scenes, narration and all — rather
/// than as the topic it came from. Regenerating from the topic would cost
/// another model call and produce a different lesson; what someone wants back
/// is the one they watched.
model Lesson {
  id String @id @default(cuid())

  /// Same two identities as a map: the browser that made it, and the account
  /// it belongs to once there is one. See lib/owner.ts.
  ownerKey String
  userId   String?

  title   String
  topic   String @default("")
  summary String @default("")

  /// The Lesson document as JSON, exactly as lib/lesson.ts hands it over.
  scenes String

  /// For the history list, which should not parse a lesson to count its scenes.
  sceneCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey, updatedAt])
  @@index([userId, updatedAt])
}

/// One worked solution, kept so it can be read again.
///
/// Its own table rather than a finished `math` job, for the reason the lesson
/// and the map have theirs: a job row is the receipt for some work, aged out
/// of the live feed a minute after it lands, and reading history out of it
/// means asking a queue what it remembers. The thing someone wants back is the
/// solution, so the solution is what is filed.
///
/// Stored as the finished document rather than as the question. Re-solving
/// would cost another model call and produce different working; what they want
/// back is the one they read.
model Solution {
  id String @id @default(cuid())

  /// The same two identities as a map or a lesson. See lib/owner.ts.
  ownerKey String
  userId   String?

  /// The problem, as the tutor understood it and as it was typed.
  title String
  topic String @default("")

  /// The MathSolution document as JSON, exactly as lib/math.ts hands it over.
  content String

  /// For the history list, which should not parse a solution to size it.
  stepCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey, updatedAt])
  @@index([userId, updatedAt])
}

/// Work that outlives the request that asked for it.
///
/// Writing a map takes ten seconds, a lesson closer to a minute. Tying that to
/// an open connection means a reload, a closed laptop or a tunnel throws away
/// work that has already been paid for — so the request only *starts* the job,
/// and the answer is written here whether anyone is still watching or not.
///
/// The result is a JSON string for the same reason a map's tree is: it is read
/// whole by the one client that asked for it, and nothing queries inside it.
model Job {
  id String @id @default(cuid())

  ownerKey String
  userId   String?

  /// "map" | "expand" | "math" | "lesson"
  kind   String
  /// "running" | "done" | "failed"
  status String @default("running")

  /// What was asked for, so a job can be understood without its result.
  input  String
  /// The answer, or as much of it as exists — a lesson writes scenes as they
  /// arrive, so a reload mid-generation picks up what is already drawn.
  result String?
  error  String?

  /// What this job produced, once it has been filed in its own table.
  lessonId  String?
  mindmapId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey, status, updatedAt])
  @@index([userId, status, updatedAt])
}

enum PlanId {
  free
  pro
}

enum BillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

/// What an account is paying for.
///
/// Keyed by the Supabase user id rather than by a row in a users table, because
/// there isn't one: identity lives in Supabase and everything here hangs off
/// that id. One row per user, written only by the Whop webhook.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  plan   PlanId             @default(free)
  status SubscriptionStatus @default(active)
  cycle  BillingCycle       @default(monthly)

  /// The end of the period already paid for. Access holds until then even
  /// after a cancellation; once it is in the past the account reads as free
  /// whatever the status says, so a missed webhook cannot hand out a plan
  /// forever. Null means no end date — a plan granted by hand.
  currentPeriodEnd  DateTime?
  /// Set when someone cancels but has time left on the clock.
  cancelAtPeriodEnd Boolean   @default(false)

  /// Whop's own ids, for matching a webhook back to an account.
  customerId     String? @unique
  subscriptionId String? @unique

  /// The email the purchase was made with, when that is all we had to go on.
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// How much of the free plan an account has spent, for good.
///
/// The free tier is an allowance to *make* things, not a shelf that holds
/// five: deleting a map has to leave the count where it was, or the limit is
/// only a limit on how many you keep at once and anyone can have as many as
/// they like by tidying up between. So this counts creations and never counts
/// down — the row outlives every map and lesson it counted.
///
/// Keyed by whatever identity made them: the account id once there is one, the
/// browser key before that. See lib/owner.ts. A paid plan never reads this at
/// all, so it keeps ticking quietly and is still right if someone goes back to
/// free.
model Usage {
  /// `userId` when signed in, `ownerKey` otherwise — not a foreign key,
  /// because accounts live in Supabase and not in this database.
  owner String @id

  mindmaps Int @default(0)
  lessons  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usage")
}

/// What someone thought, in their own words and on a seven-point face.
///
/// Seven because five is not enough to separate "fine" from "good" and nine is
/// more shades than anyone actually feels — and because an odd number keeps a
/// true middle, which is the honest answer more often than a scale designed
/// without one will admit.
///
/// The rating without the words is a number nobody can act on, and the words
/// without the rating are hard to sort. Both are kept, and the words are
/// optional: making them mandatory is how you get "asdf".
model Feedback {
  id String @id @default(cuid())

  /// Who said it — the account when there is one, the browser key otherwise.
  /// Same rule as everything else people make here. See lib/owner.ts.
  owner  String
  userId String?
  email  String?

  /// 1 (worst) to 7 (best).
  rating  Int
  message String @default("")

  /// Where they were when they said it, which is most of the context.
  from String @default("")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}
